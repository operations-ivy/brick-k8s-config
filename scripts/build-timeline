#!/usr/bin/env python3
"""Write front-door/timeline-site.yaml, the ConfigMaps behind
timeline.brick.nozdormu.cloud, from the files in front-door/timeline/:

- timeline-site: the page, the curated milestones (timeline-history.yaml) and
  the slides' neon art (art/*.svg);
- timeline-vendor: TimelineJS3 and js-yaml, vendored with their licences;
- timeline-feed-script: feed.py, run hourly by the timeline-feed CronJob.

Argo CD applies front-door/ but not its subfolders, so the sources live in
front-door/timeline/ and this file is what reaches the cluster. Rerun after
changing any of them; tests/test_timeline.py fails while it's out of date.

    scripts/build-timeline          # write it
    scripts/build-timeline --check  # exit 1 if it's out of date
"""

import argparse
import base64
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
SRC = ROOT / "front-door/timeline"
OUT = ROOT / "front-door/timeline-site.yaml"
NAMESPACE = "front-door"

# ConfigMap name -> the files in it (paths under SRC; served under their own names).
CONFIGMAPS = {
    "timeline-site": ["index.html", "timeline-history.yaml",
                      *sorted(f"art/{p.name}" for p in (SRC / "art").glob("*.svg"))],
    "timeline-vendor": ["vendor/timelinejs3-3.9.13.js", "vendor/timelinejs3-3.9.13.js.LICENSE.txt",
                        "vendor/timelinejs3-3.9.13.dark.css", "vendor/tl-icons.woff2", "vendor/tl-icons.woff",
                        "vendor/LICENSE-timelinejs3", "vendor/js-yaml-5.5.0.min.js", "vendor/LICENSE-js-yaml"],
    "timeline-feed-script": ["feed.py"],
}
BINARY = {".woff", ".woff2"}
# Characters YAML reads as line breaks: a text file holding one goes in as
# binaryData, or the API server's YAML parser changes it (js-yaml's source has a
# raw U+0085, which came back a space and kept Argo CD OutOfSync).
YAML_BREAKS = ("\x85", "\u2028", "\u2029")
HEADER = ("# Generated by scripts/build-timeline from front-door/timeline/: edit those\n"
          "# files and rerun it, not this one.\n")


class Literal(str):
    """A string written as a YAML block, so the files stay readable in diffs."""


def _literal(dumper: yaml.Dumper, value: Literal) -> yaml.ScalarNode:
    return dumper.represent_scalar("tag:yaml.org,2002:str", value, style="|")


yaml.add_representer(Literal, _literal)


def configmap(name: str, files: list[str]) -> dict:
    data, binary = {}, {}
    for rel in files:
        path = SRC / rel
        text = None if path.suffix in BINARY else path.read_text()
        if text is None or any(c in text for c in YAML_BREAKS):
            binary[path.name] = base64.b64encode(path.read_bytes()).decode()
        else:
            data[path.name] = Literal(text) if "\n" in text.rstrip("\n") or len(text) > 200 else text
    cm = {
        "apiVersion": "v1",
        "kind": "ConfigMap",
        "metadata": {
            "name": name,
            "namespace": NAMESPACE,
            "labels": {"app.kubernetes.io/name": "timeline"},
            # Too big for client-side apply's last-applied annotation (256 KiB).
            "annotations": {"argocd.argoproj.io/sync-options": "ServerSideApply=true"},
        },
        "data": data,
    }
    if binary:
        cm["binaryData"] = binary
    return cm


def render() -> str:
    docs = [configmap(name, files) for name, files in CONFIGMAPS.items()]
    return HEADER + yaml.dump_all(docs, sort_keys=False, width=10_000, allow_unicode=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--check", action="store_true", help="exit 1 if the file is out of date")
    args = parser.parse_args()
    text = render()
    if args.check:
        if not OUT.exists() or OUT.read_text() != text:
            print(f"{OUT.relative_to(ROOT)} is out of date: run scripts/build-timeline", file=sys.stderr)
            return 1
        return 0
    OUT.write_text(text)
    print(f"wrote {OUT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
