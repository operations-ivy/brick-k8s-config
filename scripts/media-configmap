#!/usr/bin/env python3
"""Write media/movies-script.yaml, the ConfigMap that carries media/'s scripts
(convert-480p.sh for the CronJob, convert-server.py and convert-worker.sh for
the workers). Run after editing one; tests/test_media.py fails until they match."""
from pathlib import Path

MEDIA = Path(__file__).resolve().parent.parent / "media"
HEADER = """\
# Generated from media/'s scripts by scripts/media-configmap: edit a script,
# then run that (tests/test_media.py fails until they match).
apiVersion: v1
kind: ConfigMap
metadata:
  name: movies-script
  namespace: media
data:
"""
SCRIPTS = ("convert-480p.sh", "convert-server.py", "convert-worker.sh")


def indent(script: str) -> str:
    """Four spaces before each non-blank line: the ConfigMap's block scalar."""
    return "".join(f"    {line}" if line.strip() else line for line in script.splitlines(keepends=True))


def render(scripts: dict[str, str]) -> str:
    return HEADER + "".join(f"  {name}: |\n{indent(text)}" for name, text in scripts.items())


def main() -> None:
    scripts = {name: (MEDIA / name).read_text() for name in SCRIPTS}
    (MEDIA / "movies-script.yaml").write_text(render(scripts))


if __name__ == "__main__":
    main()
